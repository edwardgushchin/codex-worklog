{
  "description": "Provide authoring instructions and safely commit model-authored daily work blocks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/scripts/worklog.py\"",
            "commandWindows": "py -3 -B \"%PLUGIN_ROOT%\\scripts\\worklog.py\"",
            "timeout": 5,
            "statusMessage": "Preparing worklog authoring instructions"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/scripts/worklog.py\"",
            "commandWindows": "py -3 -B \"%PLUGIN_ROOT%\\scripts\\worklog.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/scripts/worklog.py\"",
            "commandWindows": "py -3 -B \"%PLUGIN_ROOT%\\scripts\\worklog.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/scripts/worklog.py\"",
            "commandWindows": "py -3 -B \"%PLUGIN_ROOT%\\scripts\\worklog.py\"",
            "timeout": 5,
            "statusMessage": "Saving the authored work blocks"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"$PLUGIN_ROOT/scripts/worklog.py\"",
            "commandWindows": "py -3 -B \"%PLUGIN_ROOT%\\scripts\\worklog.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
